.site-route-tabs {
  position: relative;
  z-index: 20;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  padding: 11px 16px;
  background: linear-gradient(110deg, #0B1B2B, #142A40);
  border-bottom: 1px solid #C6A15A80;
}
.site-route-tabs a {
  color: #F6F3EB;
  text-decoration: none;
  font: 700 12px/1.3 Inter, sans-serif;
  padding: 10px 14px;
  border-radius: 8px;
  transition: background .2s, color .2s;
}
.site-route-tabs a:hover,
.site-route-tabs a.is-active {
  color: #EBD49B;
  background: #C6A15A20;
}
@media(max-width:600px) {
  .site-route-tabs {
    justify-content: flex-start;
    flex-wrap: nowrap;
    overflow-x: auto;
    scrollbar-width: none;
    gap: 4px;
    padding: 9px 10px;
  }
  .site-route-tabs::-webkit-scrollbar { display: none; }
  .site-route-tabs a {
    flex: 0 0 auto;
    white-space: nowrap;
    padding: 9px 11px;
    font-size: 11px;
  }
}
